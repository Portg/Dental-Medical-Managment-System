<?php
// YAK Pro - Php Obfuscator: Config File
// ↑↑↑ 以上两行是 yakpro-po 的魔法头，check_config_file() 会逐字比对文件的
//     前两行。缺失或改动会让整个配置被**静默拒绝** —— 它只往 stderr 打一行
//     Warning，然后回退到 yakpro 自带的默认配置。那份默认配置连类名和
//     命名空间一起混淆，会把
//         use Illuminate\Foundation\Console\Kernel as ConsoleKernel;
//     改写成不存在的类名（vendor/ 不参与混淆），产物连 php artisan 都起不来。
//     不要在这两行之前或之间插入任何内容，包括空行和注释。
//
// ═══════════════════════════════════════════════════════════════════
//  yakpro-po 混淆配置 — 牙科诊所管理系统
//  https://github.com/pk-fr/yakpro-po
//  由 build.sh 自动调用：
//    yakpro-po dist/app -o ... --config-file deploy/yakpro-po.cnf
//
//  选项名以 include/classes/config.php 的属性定义为准。写错名字不会报错，
//  PHP 只会创建一个动态属性，yakpro 从不读它 —— 设置静默失效。
// ═══════════════════════════════════════════════════════════════════

// ── 实际生效的混淆 ──────────────────────────────────────────────
// 字符串转十六进制转义：值不变、行为不变，是这里唯一既安全又有效果的一项
$conf->obfuscate_string_literal       = true;
$conf->obfuscate_label_name           = true;
$conf->strip_indentation              = true;

// ── 关闭的混淆，每条都有具体原因 ────────────────────────────────

// 变量名：app/ 下有 58 处 compact()。compact('patients') 按**字面量名字**
// 查找变量，变量一旦改名就找不到 —— 实测返回 array(0)，视图收到空数据，
// 页面空白或报未定义变量，且不抛异常、不留日志。
// 靠白名单列举不可行：任何新增的 compact() 都会静默失效，没有机制能提醒。
$conf->obfuscate_variable_name        = false;

// 以下均因 Laravel 依赖反射、服务容器、PSR-4 自动加载与 Eloquent 属性映射；
// 且 vendor/ 不参与混淆，跨边界的 use Vendor\Class as Alias 会指向不存在的类
$conf->obfuscate_function_name        = false;
$conf->obfuscate_class_name           = false;
$conf->obfuscate_interface_name       = false;
$conf->obfuscate_trait_name           = false;
$conf->obfuscate_class_constant_name  = false;
$conf->obfuscate_constant_name        = false;
$conf->obfuscate_property_name        = false;
$conf->obfuscate_method_name          = false;
$conf->obfuscate_namespace_name       = false;

// 语句打散会生成 goto 迷宫，线上排障代价极高而收益有限
$conf->shuffle_stmts                  = false;
$conf->obfuscate_if_statement         = false;
$conf->obfuscate_loop_statement       = false;

// 出错立即中止，不要产出半成品
$conf->abort_on_error                 = true;
$conf->confirm                        = false;
